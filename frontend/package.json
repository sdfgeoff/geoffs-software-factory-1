{
  "name": "multi-agent-board-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check:protocol": "node ../scripts/generate-protocol-types.mjs --check",
    "dev": "vite",
    "generate:protocol": "node ../scripts/generate-protocol-types.mjs",
    "lint": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-math": "^6.0.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
